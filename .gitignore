# dependencies
node_modules
/.pnp
.pnp.*

# testing
/coverage
apps/web/test-results/
apps/web/playwright-report/
apps/web/screenshots/

# next.js
apps/web/.next/
apps/web/out/

# build outputs
dist
build
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local-only secrets — never commit
*.key
*.local.sql

# prisma generated client — never edit manually, never commit
packages/db/generated

# docker volumes (if any bind-mounted locally)
.docker-data

# graphify knowledge graph (local dev tool output, not repo content)
/graphify-out

# local dev-server log (see .claude/skills/verify/SKILL.md) — deliberately
# repo-relative, not /tmp, since /tmp resolves differently under Git-Bash
# vs. native Windows Node (Playwright) and needs to be the same real file
# for both to agree on.
apps/web/.tmp/

