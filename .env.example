# Copy to .env and fill in local values. Never commit .env.

# Postgres (docker-compose defaults shown)
DATABASE_URL=postgresql://lifeos:lifeos_dev@localhost:5432/lifeos

# Redis (docker-compose default). Backs the API rate limiter and the OTP
# resend cooldown. Optional: leave it unset and both fall back to an
# in-process store, which is fine for a single dev process but counts
# per-instance — a multi-instance deploy MUST set this or each instance
# enforces its own separate copy of every limit.
REDIS_URL=redis://localhost:6379

# Which request header may be trusted for the client IP in rate limiting.
# Leave UNSET until a reverse proxy that overwrites the header is actually
# in front of the app (Stage C's Cloudflare -> cf-connecting-ip). Unset
# means per-IP limits fall back to x-forwarded-for, which a client can
# forge — see apps/web/src/lib/client-ip.ts.
TRUSTED_PROXY_IP_HEADER=

# Auth — refresh tokens are opaque random strings (hashed in the DB), only
# the short-lived access-token JWT needs a signing secret.
JWT_ACCESS_SECRET=

# SMS OTP provider (leave unset to use the mock adapter, which logs the code)
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=

# Dev-only: fixes every OTP to this 6-digit value instead of a random code,
# so you can sign in locally without reading the code out of the server log.
# Leave unset outside local dev — generateOtpCode() throws if this is set
# with NODE_ENV=production.
DEV_OTP_CODE=

# apps/web
NEXT_PUBLIC_APP_URL=http://localhost:3000
