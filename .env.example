# Copy to .env and fill in local values. Never commit .env.

# Postgres (docker-compose defaults shown)
DATABASE_URL=postgresql://lifeos:lifeos_dev@localhost:5432/lifeos

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6379

# Auth — refresh tokens are opaque random strings (hashed in the DB), only
# the short-lived access-token JWT needs a signing secret.
JWT_ACCESS_SECRET=

# SMS OTP provider (leave unset to use the mock adapter, which logs the code)
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=

# Dev-only: fixes every OTP to this 6-digit value instead of a random code,
# so you can sign in locally without reading the code out of the server log.
# Leave unset outside local dev — generateOtpCode() throws if this is set
# with NODE_ENV=production.
DEV_OTP_CODE=

# apps/web
NEXT_PUBLIC_APP_URL=http://localhost:3000
