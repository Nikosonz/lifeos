#!/bin/sh
# Secret-leak guard. No dependencies (POSIX sh; runs under Git-for-Windows
# bash). Installed via package.json "prepare" -> `git config core.hooksPath .githooks`.
#
# Blocks a commit that stages a secret file or a secret-looking value.
# Verified false positive? Bypass with:  git commit --no-verify
#
# NOTE: keep the token patterns split so this file never itself trips the scan.

fail() {
  echo ""
  echo "  ✖ pre-commit blocked: possible secret in staged changes"
  echo "  ────────────────────────────────────────────────────────"
  printf '%s\n' "$1"
  echo "  ────────────────────────────────────────────────────────"
  echo "  Remove it / use process.env. If truly a false positive:"
  echo "      git commit --no-verify"
  echo ""
  exit 1
}

# staged file paths (Added/Copied/Modified/Renamed)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 0) format + lint staged files (prettier + eslint --fix), re-staging the result.
if ! npx --no-install lint-staged; then
  echo ""
  echo "  ✖ pre-commit blocked: lint-staged failed (formatting/lint errors)"
  echo ""
  exit 1
fi

# 1) block secret-bearing file types (guards against `git add -f` past .gitignore)
for f in $staged; do
  case "$f" in
    .env.example) : ;;                       # allowed (names only)
    .env|.env.*|*/.env|*/.env.*) fail "staged env file: $f  (env files must never be committed)" ;;
    *.pem|*.key|*.local.sql)     fail "staged secret file: $f" ;;
  esac
done

# 2) scan the staged diff (added lines only) for secret token formats.
#    Patterns are assembled from pieces so the hook file itself stays clean.
added=$(git diff --cached --diff-filter=ACMR -U0 | grep '^+' | grep -v '^+++')
[ -z "$added" ] && exit 0

re_dsn='postgres(ql)?://[^ :@/]+:[^ :@/]+@'          # real DSN with credentials
re_gh='gh[pousr]'"_"'[A-Za-z0-9]{20,}'
re_ghpat='github'"_pat_"'[A-Za-z0-9_]{20,}'
re_openai='sk-[A-Za-z0-9]{20,}'
re_aws='AKIA[0-9A-Z]{16}'
re_gcp='AIza[0-9A-Za-z_-]{20,}'
re_slack='xox[baprs]-[0-9A-Za-z-]{10,}'
re_pem='BEGIN [A-Z ]*PRIVATE KEY'
re_assign='(SECRET|TOKEN|PASSWORD|API'"_"'KEY|MERCHANT'"_"'ID)[A-Za-z_]*[[:space:]]*[:=][[:space:]]*.?["'"'"'][^"'"'"']{8,}'

# combined, extended-regex
patterns="$re_dsn|$re_gh|$re_ghpat|$re_openai|$re_aws|$re_gcp|$re_slack|$re_pem|$re_assign"

# Last alternative: a "..._KEY" constant assigned a pure-alphabetic word
# (e.g. a localStorage key name, not an embedded secret) — see the matching
# comment in .githooks/pre-push, which shares this same regex/exclusion set.
hits=$(printf '%s\n' "$added" \
  | grep -nE "$patterns" \
  | grep -viE 'placeholder|process\.env|\.env\.example|example\.com|your-|xxxx|<[A-Za-z_]+>|user:pass|username:password|@localhost|@127\.0\.0\.1|[A-Za-z_]*_KEY[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z]+["'"'"']')

[ -n "$hits" ] && fail "$hits"

exit 0
