generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sync-ready fields (id/createdAt/updatedAt/deletedAt/version) are carried
// on every user-data model so mobile/offline clients can add delta sync
// later without backend changes — see CLAUDE.md "Sync-ready" convention.
enum CalendarPreference {
  JALALI
  GREGORIAN
}

// phone/email are both optional but each unique — a user needs at least one
// (enforced in AuthService, not the DB: Postgres allows multiple NULLs
// under a unique index, so a DB-level "at least one" constraint would need
// a CHECK constraint Prisma's schema language can't express directly).
// Logging in by phone once and by email another time creates two separate
// accounts — there's no identity-linking flow yet, a known/deliberate scope
// cut (see CLAUDE.md's Auth Module section).
model User {
  id                 String             @id @default(uuid())
  phone              String?            @unique
  email              String?            @unique
  // Optional, and stays optional: accounts are created by OTP verification,
  // which only ever knows an identifier. A user supplies a name on the step
  // after their first successful verify, and may skip it — so "account
  // exists" and "account has a name" are genuinely independent states, not
  // a nullable field waiting to be backfilled. Clients render a fallback
  // rather than assuming it's set.
  name               String?
  timezone           String             @default("Asia/Tehran")
  calendarPreference CalendarPreference @default(JALALI)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  version            Int                @default(1)

  sessions         Session[]
  wallets          FinanceWallet[]
  financeCategories FinanceCategory[]
  transactions     FinanceTransaction[]
  budgets          FinanceBudget[]
  idempotencyKeys  IdempotencyKey[]
  taskProjects     TaskProject[]
  tasks            Task[]
  subtasks         Subtask[]
  taskLabels       TaskLabel[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  habits           Habit[]
  habitCheckIns    HabitCheckIn[]
  telemetryCrashes TelemetryCrash[]
  telemetryEvents  TelemetryEvent[]

  @@map("users")
}

enum OtpChannel {
  SMS
  EMAIL
}

// Not tied to a User row — an identifier can request an OTP before any
// account exists (verifyOtp find-or-creates the user on success).
// `identifier` holds a phone number when channel=SMS or an email address
// when channel=EMAIL — the two channels share this one table (same
// cooldown/attempt-limit/expiry rules either way) rather than duplicating
// it, since nothing else about OTP issuance differs between them.
model OtpCode {
  id         String     @id @default(uuid())
  channel    OtpChannel
  identifier String
  codeHash   String
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([channel, identifier, createdAt])
  @@map("otp_codes")
}

// Refresh tokens are opaque random strings, never JWTs — storing only the
// hash here (never the plaintext) is what makes revocation possible; a JWT
// refresh token could not be invalidated before its own expiry.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  expiresAt        DateTime

  @@index([userId])
  @@map("sessions")
}

// Append-only — services write here, nothing ever updates/deletes a row.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

// --- Finance module ---
// Models are prefixed Finance* because this schema file is shared by every
// future domain module (Tasks, Habits, Calendar) that could plausibly want
// the same generic name (Category, Transaction). IdempotencyKey below is
// deliberately NOT prefixed — it's designed to be reused by any module's
// idempotent mutations via its resourceType discriminator.

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

// Balance is never stored here — it's derived on read via a groupBy sum
// over FinanceTransaction (see WalletService.listWithBalances). Storing
// and mutating a running total would need correct debit/credit reversal
// logic on every transaction edit path; deriving it avoids that entirely.
model FinanceWallet {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  currency  String    @default("IRR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  transactions FinanceTransaction[]

  @@index([userId])
  @@map("finance_wallets")
}

model FinanceCategory {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      FinanceCategoryType
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  version   Int                 @default(1)

  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@index([userId])
  @@map("finance_categories")
}

// userId is denormalized from wallet.userId (validated at write time in
// TransactionService, not a DB constraint) so listing/summing a user's own
// transactions never needs to join through FinanceWallet.
model FinanceTransaction {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId   String
  wallet     FinanceWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  categoryId String
  category   FinanceCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type       FinanceTransactionType
  amount     BigInt
  currency   String                 @default("IRR")
  occurredAt DateTime
  note       String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  deletedAt  DateTime?
  version    Int                    @default(1)

  @@index([userId, occurredAt])
  @@index([walletId])
  @@index([categoryId])
  @@map("finance_transactions")
}

model FinanceBudget {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jalaliYear  Int
  jalaliMonth Int
  limitAmount BigInt
  currency    String          @default("IRR")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  version     Int             @default(1)

  @@unique([userId, categoryId, jalaliYear, jalaliMonth])
  @@index([userId, jalaliYear, jalaliMonth])
  @@map("finance_budgets")
}

// Shared, reusable idempotency ledger for money-mutating (or future
// similarly sensitive) endpoints. resourceType/resourceId point at the row
// the mutation produced; a replay re-fetches that row's *current* state
// rather than storing a separate response snapshot, which is sufficient
// as long as "the response" is just that one row's state (true for
// FinanceTransaction create/update, this module's only consumer so far).
model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  requestHash  String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// --- Tasks module ---
// Project/Label are prefixed Task* for the same reason Finance's models
// are prefixed Finance* — both nouns are generic enough that a future
// module (Notes, Habits) could plausibly want them too.

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskProject {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  tasks Task[]

  @@index([userId])
  @@map("task_projects")
}

// position is a flat per-user Float, not scoped per status column — see
// packages/core/src/tasks/position.ts for the append/midpoint/renumber
// scheme. No DB-level uniqueness on position: a momentary tie during a
// reorder is an ambiguous-but-harmless read order, not a data integrity
// violation.
model Task {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     TaskProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  deadline    DateTime?
  completedAt DateTime?
  position    Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  version     Int        @default(1)

  subtasks Subtask[]
  labels   TaskLabel[]

  @@index([userId, position])
  @@index([userId, status])
  @@index([userId, projectId])
  @@map("tasks")
}

// userId is denormalized from task.userId (validated at write time in
// SubtaskService, not a DB constraint) — same reasoning as
// FinanceTransaction.userId relative to its wallet.
model Subtask {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean   @default(false)
  position  Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([taskId, position])
  @@map("subtasks")
}

// The Task<->TaskLabel join is a pure relational m2m with no client-facing
// identity of its own — no sync-ready fields needed on the join itself.
// Attaching/detaching is a full-replace `labelIds` field on Task, not
// dedicated add/remove endpoints (see TaskService).
model TaskLabel {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  tasks Task[]

  @@unique([userId, name])
  @@map("task_labels")
}

// --- Calendar module ---

enum CalendarRecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// startAt/endAt are always both required (a zero-duration point event has
// endAt == startAt) so recurrence expansion always has a well-defined
// duration to widen its range-overlap search window by — see
// packages/core/src/calendar/recurrence.ts. recurrenceByWeekday is
// JS-convention (0=Sunday..6=Saturday) — mapped to rrule's Monday-based
// enum only inside recurrence.ts, never exposed past it. The
// [userId, startAt] index only serves non-recurring events directly:
// recurring events for a user are fetched unconditionally (a recurring
// event created years ago can still produce valid occurrences today, so it
// can't be pre-filtered by SQL on startAt) and expanded in-process.
model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean   @default(false)

  recurrenceFreq      CalendarRecurrenceFreq?
  recurrenceInterval  Int       @default(1)
  recurrenceCount     Int?
  recurrenceUntil     DateTime?
  recurrenceByWeekday Int[]     @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([userId, startAt])
  @@map("calendar_events")
}

// --- Notifications module ---
// In-app only this pass — no push/SMS/email channel, no time-based/scheduled
// triggers (apps/worker is a documented placeholder — see CLAUDE.md Known
// Limitations). Created exclusively as a server-side side effect of another
// module's service call (see ADR-0009) — there is no client-callable POST
// route for this model.
//
// `type` is a plain String, not a Prisma enum — see ADR-0011. A closed enum
// here meant every future triggering module (a task-deadline reminder, an
// auth new-device alert) had to edit this schema file, contradicting
// NotificationService's own "deliberately domain-agnostic" design. Each
// producing module keeps its own local string-literal type for the values
// it sends instead (see FinanceNotificationEventType in
// transaction-service.ts).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([userId, updatedAt])
  @@map("notifications")
}

// --- Habits module ---
// Streaks are computed on read from HabitCheckIn rows, never stored — same
// "derived, never stored" precedent as FinanceWallet's balance (see
// packages/core/src/habits/streak.ts). Un-checking a day soft-deletes the
// check-in row; re-checking the same day revives (undeletes) that same row
// rather than inserting a duplicate that would violate the unique
// constraint below.

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  frequency   HabitFrequency @default(DAILY)
  // Only meaningful when frequency == WEEKLY. JS Date.getDay() convention
  // (0=Sunday..6=Saturday) — same as CalendarEvent.recurrenceByWeekday.
  weekdays  Int[]     @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  checkIns HabitCheckIn[]

  @@index([userId])
  @@map("habits")
}

// jalaliYear/jalaliMonth/jalaliDay (not a truncated UTC instant) is the
// uniqueness key for "one check-in per habit per day" — the same precedent
// FinanceBudget's (userId, categoryId, jalaliYear, jalaliMonth) unique
// constraint already established, extended to day granularity so a day
// boundary is always resolved via the shared Jalali conversion, never a
// timestamp-truncation assumption. checkedAt is the real instant logged,
// kept for display/audit only, never used for uniqueness or streak math.
model HabitCheckIn {
  id          String    @id @default(uuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jalaliYear  Int
  jalaliMonth Int
  jalaliDay   Int
  checkedAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  @@unique([habitId, jalaliYear, jalaliMonth, jalaliDay])
  @@index([userId, jalaliYear, jalaliMonth])
  @@map("habit_checkins")
}

// Telemetry (ADR-0017): self-hosted crash reporting + analytics on our own
// backend, because ADR-0014's GMS ban rules out Firebase Crashlytics on the
// exact devices this app targets.
//
// Both models carry the standard sync-ready fields even though telemetry is
// write-only and has no cross-client sync need — CLAUDE.md's Module Pattern
// applies to every user-data model, and consistency beats a one-off exception
// nobody would remember the reason for.

enum TelemetryCrashKind {
  // FlutterError.onError — a synchronous framework/build error.
  FLUTTER_ERROR
  // PlatformDispatcher.onError / runZonedGuarded — an uncaught async error,
  // which before this module was swallowed silently on device.
  UNCAUGHT_ASYNC
}

// A closed set on purpose (ADR-0017: "a small typed event enum ... deliberately
// not free-form string events"). Adding an event is a schema migration + a
// contract change, which is the point: it keeps the analytics surface something
// you can read in one screen rather than an untyped bag that accretes.
//
// Deliberately no properties/metadata column. Anything worth segmenting on
// should become its own enum member; a JSON bag would reintroduce exactly the
// free-form shape this enum exists to prevent.
enum TelemetryEventName {
  APP_OPENED
  SIGNUP_COMPLETED
  LOGIN_COMPLETED
  TRANSACTION_CREATED
  BUDGET_CREATED
  TASK_CREATED
  HABIT_CHECKED_IN
  CALENDAR_EVENT_CREATED
  REPORT_VIEWED
}

model TelemetryCrash {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       TelemetryCrashKind
  message    String
  stackTrace String

  // Client build/runtime context, all client-supplied and display-only —
  // never a decision input, same standing rule as Session.ipAddress.
  appVersion  String
  platform    String
  osVersion   String?
  deviceModel String?

  // When the crash actually happened on-device, which is usually well before
  // createdAt: a process that just crashed can rarely complete a network call,
  // so reports buffer to disk and flush on the *next* launch. Ordering and
  // grouping must use this, never createdAt.
  occurredAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([userId, occurredAt])
  @@map("telemetry_crashes")
}

model TelemetryEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       TelemetryEventName
  appVersion String
  platform   String

  // Same reasoning as TelemetryCrash.occurredAt: events batch client-side, so
  // the instant they happened is not the instant they arrived.
  occurredAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([userId, occurredAt])
  @@index([name, occurredAt])
  @@map("telemetry_events")
}
