# NOTE: unlike .gitignore, a bare pattern here (e.g. `.env*`) only matches
# at the context root, NOT at every depth — verified directly (a repo-root
# `.env*` failed to exclude apps/web/.env and packages/db/.env; the fix is
# an explicit `**/` prefix on every pattern that must match at any depth).
# Every pattern below is doubled (bare + `**/`) rather than relying on this
# distinction being remembered correctly next time this file is edited.

# Reinstalled fresh inside the image — never copy a host-installed tree in
# (also avoids shipping host-platform native binaries, e.g. Windows sharp).
node_modules
**/node_modules

# Regenerated by `prisma generate` inside the build stage — never copy a
# stale or wrong-platform host-generated client in (see .gitignore).
packages/db/generated

# Build outputs — regenerated inside the image.
apps/web/.next
apps/worker/dist
dist
build
**/dist
**/build
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# VCS / editor / CI-irrelevant project files.
.git
.github
.claude
docs
*.md
**/*.md

# Env files — secrets are injected at deploy time, never baked into a layer.
.env*
**/.env*
!.env.example
!**/.env.example

# Test artifacts, local-only files.
coverage
apps/web/test-results
apps/web/playwright-report
apps/web/.tmp
.docker-data
/graphify-out
